// ofuda_eyes.svg を使ったお札 / 単位: mm
// SVG の余白を除く輪郭の長辺を150mmにする。
long_side = 150;
thickness = 1.2; // 下地0.6mmと浮き彫り0.6mmを含む全体の厚さ
relief_height = 0.6;
cord_hole_diameter = 6;
cord_hole_top_offset = 8; // 先端から穴中心まで。上部中央に配置
style = "relief"; // [relief, silhouette]

// 元SVGの外周座標。import(center=true) と同じ中心・向きに配置。
source_width = 533;
source_height = 1756;
size_scale = long_side / source_height;
base_height = thickness - relief_height;
eps = 0.01;

assert(long_side > 0 && thickness > 0);
assert(relief_height > 0 && relief_height < thickness);
assert(style == "relief" || style == "silhouette");
assert(cord_hole_diameter > 0);
assert(cord_hole_top_offset > cord_hole_diameter / 2);

module artwork() {
    // 白背景を除き、座標単位をmmに統一した ofuda_eyes.svg の派生データ。
    // 微小な点接触を補正して閉じた立体にする。
    intersection() {
        outline();
        offset(delta=0.001)
            scale([size_scale, size_scale])
                import("ofuda_eyes_relief.svg", center=true);
    }
}

