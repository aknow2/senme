module ofuda_body() {
    if (style == "relief") {
        union() {
            linear_extrude(height=base_height) outline();
            translate([0, 0, base_height - eps])
                linear_extrude(height=relief_height + eps) artwork();
        }
    } else {
        linear_extrude(height=thickness) artwork();
    }
}

difference() {
    ofuda_body();
    translate([0, long_side / 2 - cord_hole_top_offset, -eps])
        cylinder(d=cord_hole_diameter, h=thickness + 2 * eps, $fn=96);
}

echo("外寸", [source_width * size_scale, long_side, thickness]);
